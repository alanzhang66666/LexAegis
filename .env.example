# Copy to .env; scripts/dev.py loads it. Keep this file free of real keys.
LEX_DATA_DIR=.data/app
LEX_GATEWAY_DIR=.data/gateway
LEX_GATEWAY_URL=http://127.0.0.1:8766
# Create a long shared signing key for API-to-gateway envelopes in deployment.
LEX_GATEWAY_SECRET=
# Set your login password; dev launcher generates one when omitted.
LEX_LOCAL_PASSWORD=
# API root must end in /v1; only the gateway receives the cloud credential.
LEX_CLOUD_API_KEY=
LEX_CLOUD_ALLOWED_HOSTS=api.openai.com
LEX_EDGE_URL=http://127.0.0.1:11434/v1
LEX_EDGE_MODEL=
LEX_OCR_ENABLED=0
