# Copy to .env; `lexaegis start` loads it from the working directory. Keep this file free of real keys.
LEX_DATA_DIR=.data/app
LEX_GATEWAY_DIR=.data/gateway
LEX_GATEWAY_URL=http://127.0.0.1:8766
# Create a long shared signing key for API-to-gateway envelopes in deployment.
LEX_GATEWAY_SECRET=
# Set your login password; dev launcher generates one when omitted.
LEX_LOCAL_PASSWORD=
# 本地会话绑定具名身份与角色：admin/case_operator/legal_reviewer/approver
LEX_LOCAL_ACTOR=local-lawyer
LEX_LOCAL_ROLE=admin
# API root must end in /v1; only the gateway receives cloud credentials.
LEX_CLOUD_PRIMARY_KEY=
LEX_CLOUD_STANDBY_KEY=
# Compatibility alias for the primary slot when LEX_CLOUD_PRIMARY_KEY is empty.
LEX_CLOUD_API_KEY=
LEX_CLOUD_ALLOWED_HOSTS=api.deepseek.com,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com,api.openai.com
# D 路径试点：收紧为仅 api.deepseek.com，并关闭备槽。不要把 DeepSeek Key 指向百炼。
# LEX_CLOUD_PILOT_PATH=D
# LEX_CLOUD_ALLOWED_HOSTS=api.deepseek.com
# Optional standby host: dashscope-intl.aliyuncs.com, or an allowlisted *.maas.aliyuncs.com workspace.
# LEX_CLOUD_STANDBY_HOST=dashscope-intl.aliyuncs.com
# Native GGUF (llama-server): MiniCPM5-2B Q4_K_M served as edge-small
# Weight: https://huggingface.co/openbmb/MiniCPM5-2B-GGUF  MiniCPM5-2B-Q4_K_M.gguf
# This is a deployment recipe, not an install or benchmark claim.
# LEX_EDGE_GGUF=models/MiniCPM5-2B-Q4_K_M.gguf
# LEX_EDGE_BIN=.artifacts/llama-server/llama-server.exe
# LEX_EDGE_CTX_SIZE=32768
# LEX_EDGE_BATCH_SIZE=2048
# LEX_EDGE_UBATCH_SIZE=512
# LEX_EDGE_N_GPU_LAYERS=99
# LEX_EDGE_FLASH_ATTN=on
# LEX_EDGE_SECOND_PASS_THINKING=0
# LEX_EDGE_EXTRACT_MAX_FACTS=40
# LEX_EDGE_EXTRACT_MAX_EVENTS=8
# LEX_EDGE_EXTRACT_MAX_EVENT_CHARS=80
# LEX_EDGE_EXTRACT_MAX_TOKENS=3072
# LEX_EDGE_IDLE_UNLOAD_SECONDS=300
LEX_EDGE_URL=http://127.0.0.1:8080/v1
LEX_EDGE_MODEL=edge-small
# Cross-round outbound engineering budget (not a legal pack field). Defaults: 50000 chars, 20 entries.
# LEX_DISCLOSURE_BUDGET_CHARS=50000
# LEX_DISCLOSURE_BUDGET_ENTRIES=20
# Optional native ports when 8765 is already taken (Playwright uses 18765/18766).
# LEX_API_PORT=8765
# LEX_GATEWAY_PORT=8766
# Compose host publish is loopback only. Container port stays 8765. Never 0.0.0.0.
# Windows Docker Desktop may emit `invalid IP:0` for 127.0.0.1:8765.
# If 28765 is also empty, use 38765 (Playwright uses 18765).
# LEX_COMPOSE_API_PORT=38765
# Local OCR default is RapidOCR + ONNX Runtime CUDA. No cloud OCR.
# Paddle is CPU rollback only: LEX_OCR_PROVIDER=paddle. Do not install paddlepaddle-gpu.
LEX_OCR_ENABLED=0
LEX_OCR_PROVIDER=rapidocr
# Set to 1 only after matching OCR model assets are already present offline.
LEX_OCR_MODELS_READY=0
# LEX_OCR_MODELS_DIR=models/rapidocr
# File transcription: local FFmpeg + whisper.cpp CUDA + large-v3-turbo. No cloud whisper.
LEX_WHISPER_ENABLED=0
LEX_WHISPER_PROVIDER=whisper.cpp
LEX_WHISPER_MODELS_READY=0
# LEX_WHISPER_BIN=.artifacts/whisper/whisper-cli.exe
# LEX_WHISPER_MODEL=models/ggml-large-v3-turbo.bin
# LEX_FFMPEG_BIN=ffmpeg
# native is cross-platform but never satisfies formal isolation; compose sets isolated.
LEX_DEPLOYMENT_MODE=native
# Red-team evaluate host. Unset: native -> http://127.0.0.1:8767;
# isolated (LEX_DEPLOYMENT_MODE=isolated or LEX_ISOLATED=1) -> http://redteam:8767.
# Native start does not launch redteam; start it separately if needed.
# LEX_REDTEAM_URL=http://127.0.0.1:8767
# Must be a distinct secret from LEX_GATEWAY_SECRET. Do not reuse the gateway key.
# LEX_REDTEAM_SECRET=
